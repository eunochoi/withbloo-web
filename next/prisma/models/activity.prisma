model Diary {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(30)
  emotion   Int
  text      String
  date      String   @db.VarChar(10)
  userId    Int      @map("UserId")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Diary N : 1 User, onDelete: Cascade - 사용자를 삭제하면 일기도 함께 삭제
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Diary 1 : N Image
  images Image[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("Diary")
}

model Habit {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(30)
  name      String   @db.VarChar(50)
  description String? @db.VarChar(100)
  priority  Int
  iconKey   String   @default("goal") @db.VarChar(32)
  iconColor String   @default("theme") @db.VarChar(32)
  initialStartedAt DateTime @default(now())
  userId    Int      @map("UserId")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Habit N : 1 User, onDelete: Cascade - 사용자를 삭제하면 습관도 함께 삭제
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]
  records HabitRecord[]

  @@unique([userId, name])
  @@index([userId])
  @@map("Habit")
}

model HabitCompletion {
  habitId   Int
  date      String @db.VarChar(10)
  createdAt DateTime @default(now())
  habit     Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@id([habitId, date])
  @@index([date])
}

model HabitRecord {
  id         Int      @id @default(autoincrement())
  habitId    Int
  recordedAt DateTime
  memo       String   @map("text") @db.VarChar(500)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  habit      Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  images     HabitRecordImage[]

  @@index([habitId, recordedAt, id])
}

// Keep one-off SQL data migrations recorded across prisma db push operations.
model DataMigration {
  name      String   @id
  appliedAt DateTime @default(now())

  @@map("_TookDataMigration")
}

model Sober {
  id               Int            @id @default(autoincrement())
  userId           Int
  name             String         @db.VarChar(30)
  description      String?        @db.VarChar(100)
  iconKey          String
  iconColor        String         @default("theme")
  isPriority       Boolean        @default(false)
  initialStartedAt DateTime
  goalMode         String         @default("AUTO")
  goalDays         Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  restarts         SoberRecord[]

  @@unique([userId, name])
  @@index([userId, createdAt])
}

model SoberRecord {
  id          Int      @id @default(autoincrement())
  soberId     Int
  isRestart   Boolean  @default(false)
  restartedAt DateTime @map("recordedAt")
  memo        String?  @map("text") @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sober       Sober    @relation(fields: [soberId], references: [id], onDelete: Cascade)
  images      SoberRecordImage[]

  @@index([soberId, restartedAt, id])
  @@index([soberId, isRestart, restartedAt, id])
}

model HabitRecordImage {
  id Int @id @default(autoincrement())
  habitRecordId Int
  imageContentId String
  position Int
  habitRecord HabitRecord @relation(fields: [habitRecordId], references: [id], onDelete: Cascade)
  imageContent ImageContent @relation(fields: [imageContentId], references: [id], onDelete: Restrict)
  @@unique([habitRecordId, position])
  @@index([imageContentId])
}

model SoberRecordImage {
  id Int @id @default(autoincrement())
  soberRecordId Int
  imageContentId String
  position Int
  soberRecord SoberRecord @relation(fields: [soberRecordId], references: [id], onDelete: Cascade)
  imageContent ImageContent @relation(fields: [imageContentId], references: [id], onDelete: Restrict)
  @@unique([soberRecordId, position])
  @@index([imageContentId])
}
